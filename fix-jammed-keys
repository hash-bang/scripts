#!/bin/bash
# Fixed sticky keys that are stuck down

# Set the display to the primary
export DISPLAY=:0.0

# Unstick any key that's currently held down, not just modifiers.
# Query the core keyboard's actual key state (XQueryKeymap, via `xinput
# query-state`) so a jam on ANY keycode gets caught, not just a fixed list.
release_held_keys() {
	local KEYBOARD_IDS
	local ID
	local KEYCODES
	# `xinput query-state` only works on slave (physical) devices, not the
	# master keyboard, so check every logical keyboard device rather than
	# trying to guess a single "the" keyboard id.
	KEYBOARD_IDS=$(xinput list | grep -i 'slave *keyboard' | grep -oP '(?<=id=)[0-9]+')
	KEYCODES=$(for ID in $KEYBOARD_IDS; do xinput query-state "$ID" 2>/dev/null | grep '=down$'; done | grep -oE '[0-9]+' | sort -un)
	if [[ -n "$KEYCODES" ]]; then
		echo "Releasing held keycodes: $KEYCODES"
		xdotool keyup $KEYCODES
	fi
}
release_held_keys

# Release Caps, Num, Scroll and Compose Lock keys
declare -A LOCK_BIT=(
	[caps]=1
	[num]=2
	[scroll]=4
	[compose]=8
)

declare -A LOCK_KEY=(
	[caps]=Caps_Lock
	[num]=Num_Lock
	[scroll]=Scroll_Lock
	[compose]=Multi_key
)

lock_on() {
	local MASK=$(xset q | sed -n 's/.*LED mask:[[:space:]]*//p')
	(( 0x$MASK & ${LOCK_BIT[$1]:-0} ))
}

release_locks() {
	local NAME
	for NAME in "${@:-${!LOCK_BIT[@]}}"; do
		if lock_on "$NAME"; then
			echo "Releasing ${LOCK_KEY[$NAME]}"
			xdotool key "${LOCK_KEY[$NAME]}"
		fi
	done
}
release_locks
