#!/bin/bash
# Grep a list of PM2 processes for a string
# Usage: pm2-grep <grep-expr>

HELP="
pm2-grep [options...] [grep-expr]

Grep PM2 process names, returning matches


[grep-expr]              Grep expression to search for or literal process name

-0, --print0             Output as a null-terminated list (useful with 'pm2-grep -0 THING | xargs -0 CMD')

-q, --quiet              Grep but show no output, only populate the exit code if there was at least one match

--only <running|stopped> Further filter matches to only running or only stopped PM2 processes

-h, --help               Show command line help
"

# Defaults {{{
ARG_OUTPUT=list
ARG_ONLY=
# }}}

# Argument processing {{{
PARAMS=""
while (( "$#" )); do
	case "$1" in
		-0|--print0)
			ARG_OUTPUT=null
			shift
			;;
		-q|--quiet)
			ARG_OUTPUT=quiet
			shift
			;;
		--only)
			ARG_ONLY="$2"
			if [ "$ARG_ONLY" != "running" ] && [ "$ARG_ONLY" != "stopped" ]; then
				echo "Error: --only must be 'running' or 'stopped'" >&2
				exit 1
			fi
			shift 2
			;;
		--) # end argument parsing
			shift
			break
			;;
		-*|--*=) # unsupported flags
			echo "Error: Unsupported flag $1" >&2
			exit 1
			;;
		*) # preserve positional arguments
			PARAMS="$PARAMS $1"
			shift
			;;
	esac
done
PARAMS=${PARAMS## } # remove leading spaces
# }}}

# Fetch PM2 list as JSON, filter by name + optional status via jq {{{
JQ_FILTER='.[] | select(.name | test($pattern))'
JQ_ARGS=(--arg pattern "$PARAMS")

if [ "$ARG_ONLY" == "running" ]; then
	JQ_FILTER="$JQ_FILTER | select(.pm2_env.status == \$status)"
	JQ_ARGS+=(--arg status "online")
elif [ "$ARG_ONLY" == "stopped" ]; then
	JQ_FILTER="$JQ_FILTER | select(.pm2_env.status == \$status)"
	JQ_ARGS+=(--arg status "stopped")
fi

JQ_FILTER="$JQ_FILTER | .name"

PROCS=`pm2 jlist | jq -r "${JQ_ARGS[@]}" "$JQ_FILTER"`
# }}}

if [ -z "$PROCS" ]; then
	# No procs to list - exit with error code
	exit 1
elif [ "$ARG_OUTPUT" == "list" ]; then
	# Output as newline-terminated list
	echo "$PROCS"
elif [ "$ARG_OUTPUT" == "null" ]; then
	# Output null encoded strings
	echo "$PROCS" | tr '\n' '\0'
elif [ "$ARG_OUTPUT" == "quiet" ]; then
	# Quiet mode - above check shoudl already exit with non-zero exit code if nothing was found
	exit 0
else
	echo "Unknown output mode [${ARG_OUTPUT}]"
	exit 1
fi
